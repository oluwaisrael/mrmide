@page
@model IndexModel
@{
    ViewData["Title"] = "Forecaster — Real-time golf analysis";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

<main class="site-shell">
    <nav class="nav container" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="Forecaster home">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
            <span>Forecaster</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">Menu <span>☰</span></button>
        <div id="site-menu" class="nav-links">
            <a href="#features">Features</a>
            <a href="#membership">Membership</a>
            <a href="#faq">FAQ</a>
            <a class="nav-cta" href="#membership">Get Forecaster <span>↗</span></a>
        </div>
    </nav>

    <section id="top" class="hero container">
        <div class="hero-copy">
            <p class="eyebrow"><span class="pulse"></span> The future of golf is here</p>
            <h1>Real-time golf<br />analysis from<br /><em>the future</em></h1>
            <p class="lede">Get a deeper understanding of your game with real-time audio feedback to power your golf game.</p>
            <div class="hero-actions"><a class="button button-green" href="#membership">Get Forecaster <span>↗</span></a><a class="button button-quiet" href="#features">How it works <span>↓</span></a></div>
            <div class="hero-proof"><span class="rating" aria-label="Five star rating">★★★★★</span><span class="quote">“Now I’m hitting birdies instead of branches.”</span><span class="avatar avatar-a"></span><span class="author">Tiger Forester, USA</span></div>
        </div>
        <div class="radar" aria-label="Golf ball flight analytics illustration">
            <div class="ring ring-outer"></div><div class="ring ring-mid"></div><div class="ring ring-inner"></div>
            <div class="ball"><span></span></div>
            <div class="metric metric-top"><b>4000rpm</b><small>Spin rate</small></div>
            <div class="metric metric-right"><b>27%</b><small>Accuracy</small></div>
            <div class="metric metric-bottom"><b>90mph</b><small>Ball speed</small></div>
        </div>
    </section>

    <div class="trustbar container"><span>Meet Forecaster.</span><span class="trust-dot"></span><span class="trust-copy">The smart golf ball that delivers real-time audio feedback to your Bluetooth earbuds and saves every swing’s data in the app for future analysis.</span></div>

    <section id="features" class="features section-dark">
        <div class="container">
            <h2 class="section-title">Features</h2>
            <div class="feature-grid">
                <article class="feature-card feature-large">
                    <div class="feature-visual course-visual"><img src="~/images/golfer-swing.jpg" alt="Golfer completing a swing on a sunny course" /><span class="shot-line"></span><div class="feature-overlay"></div></div>
                    <div class="feature-body"><p class="kicker">Instant Shot Breakdown</p><h3>Understand your shot<br />as it happens.</h3><p>Get immediate insight into every swing, from launch to landing.</p></div>
                </article>
                <article class="feature-card feature-large feature-audio">
                    <div class="feature-visual portrait-visual"><img src="~/images/golfer-portrait.jpg" alt="Golfer wearing a cap on the course" /><span class="portrait-wash"></span></div>
                    <div class="feature-body"><p class="kicker">Real-time Audio Feedback</p><h3>Listen, learn,<br />and improve.</h3><p>Receive clear, useful audio guidance while your round is still in play.</p></div>
                </article>
                <article class="feature-card feature-data">
                    <div class="phone-mini"><img src="~/images/golf-ball.jpg" alt="Close-up of a golf ball" /><span class="phone-stat">32%</span></div>
                    <div class="feature-body"><p class="kicker">Death by Data</p><h3>All your data,<br />in one place.</h3><p>Every swing, tracked and ready whenever you need it.</p></div>
                </article>
            </div>
        </div>
    </section>

    <section id="membership" class="membership section-dark">
        <div class="container narrow"><p class="eyebrow centered">Membership</p><h2>Go further with<br />Forecaster.</h2><p class="section-lede">It’s $500 per golf ball each year, so you can improve your margins further by kindly providing us with recurring revenue.</p>
            <div class="plans">
                <article class="plan"><p class="plan-name">Basic</p><strong>Free</strong><ul><li>1st mile analysis</li><li>No saved data</li></ul><a href="mailto:hello@forecaster.golf?subject=Basic%20membership" class="button button-green">Get Basic <span>↗</span></a></article>
                <article class="plan plan-highlight"><p class="plan-name">Pro</p><strong><sup>$19</sup>/month</strong><ul><li>1st and 2nd radius reads</li><li>Real-time insights</li></ul><a href="mailto:hello@forecaster.golf?subject=Pro%20membership" class="button button-green">Get Pro <span>↗</span></a></article>
                <article class="plan"><p class="plan-name">Premium</p><strong><sup>$39</sup>/month</strong><ul><li>All feedback modes</li><li>Advanced analytics</li></ul><a href="mailto:hello@forecaster.golf?subject=Premium%20membership" class="button button-green">Get Premium <span>↗</span></a></article>
            </div>
        </div>
    </section>

    <section id="faq" class="faq section-light"><div class="container faq-layout"><h2>Frequently<br />Asked<br /><em>Forecaster</em><br />Questions</h2><div class="faq-list">
        <details open><summary>What happens if my ball gets destroyed? <span>+</span></summary><p>Your membership covers replacement and keeps your player profile intact.</p></details>
        <details><summary>Does this work for left-handed players? <span>+</span></summary><p>Yes. Forecaster adapts its analysis to your stance and swing direction.</p></details>
        <details><summary>Can Forecaster fix my swing? <span>+</span></summary><p>It gives you the immediate feedback needed to understand and improve it.</p></details>
        <details><summary>Does the ball work without Bluetooth? <span>+</span></summary><p>Core swing data is saved and syncs when a connection is available.</p></details>
        <details><summary>Is this real? <span>+</span></summary><p>It is a concept for a smarter, more connected way to play golf.</p></details>
    </div></div></section>

    <footer class="footer section-dark">
        <div class="container footer-lockup"><a class="footer-wordmark" href="#top"><span class="footer-mark brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><span>Forecaster</span></a></div>
        <div class="container footer-meta"><span>◎ &nbsp;× &nbsp;▣</span><span>© 2025 Pitch Academy</span></div>
    </footer>
</main>
<script src="~/js/site.js"></script>
</body>
</html>
